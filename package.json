{
  "name": "book-recommendation-bot",
  "version": "1.0.0",
  "description": "Telegram bot for book recommendations based on user preferences.",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "dev": "ALLOW_POLLING=true node --watch src/index.js",
    "test": "node --test tests/*.test.js",
    "check": "npm run validate-books && npm test",
    "validate-books": "node scripts/validate-books.js",
    "set-webhook": "node scripts/set-webhook.js",
    "delete-webhook": "node scripts/delete-webhook.js",
    "webhook:status": "node scripts/webhook-status.js",
    "token:fingerprint": "node scripts/token-fingerprint.js"
  },
  "keywords": [
    "telegram",
    "bot",
    "books",
    "recommendations"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.6.1",
    "node-telegram-bot-api": "^0.66.0"
  }
}
