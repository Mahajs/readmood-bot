TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
GOOGLE_BOOKS_API_KEY=your_google_books_api_key_here
WEBHOOK_BASE_URL=https://your-project.vercel.app
TELEGRAM_WEBHOOK_SECRET=replace_with_random_secret

# SHA-256 fingerprint of the PRODUCTION bot token (NOT the token itself).
# Generate once against the production token with: npm run token:fingerprint
# When the running token matches this, polling is hard-refused so it can never
# delete the production webhook.
# Only used by LOCAL tooling (polling guard, delete-webhook). The Vercel webhook
# handler never reads it, so do NOT add this variable to Vercel.
PRODUCTION_BOT_TOKEN_SHA256=

# Opt-in switch for local long polling. Off by default so `npm start` never
# polls by accident. `npm run dev` sets it automatically. Use only with a DEV bot token.
ALLOW_POLLING=false

# --- Monitoring (Vercel Cron health check; see README "Monitoring") ---
# Secret for Vercel Cron authorization. When set in Vercel, Vercel automatically
# sends it as "Authorization: Bearer <CRON_SECRET>" to the cron endpoint. The
# health-check endpoint fails closed without it. Set in Vercel (and locally only
# if you want to call the endpoint by hand).
CRON_SECRET=replace_with_random_secret
# Telegram chat id that receives monitoring alerts (your personal chat).
ADMIN_CHAT_ID=
